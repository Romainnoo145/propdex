{
  "framework": null,
  "buildCommand": "pnpm install && npx vite build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "internal-agent-context-rollout": false
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://api-production-349d.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-production-349d.up.railway.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
