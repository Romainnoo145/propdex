{
  "framework": null,
  "buildCommand": "pnpm install && npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://api-production-7f87.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-production-7f87.up.railway.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
