# Propdex API — Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ========================================
# Database Configuration
# ========================================
# PostgreSQL connection URL for async SQLAlchemy
# Format: postgresql+asyncpg://username:password@host:port/database
#
# Development: Use postgres superuser (RLS bypassed for easier debugging)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/propdex
#
# Production: Use app_role for runtime (RLS enforced per-organization)
# Create the role first: psql -f sql/setup_app_role.sql
# DATABASE_URL=postgresql+asyncpg://app_role:CHANGE_ME@localhost:5434/propdex

# Superuser database URL for Alembic migrations (leave empty to use DATABASE_URL)
# In production, use a separate superuser account for schema changes
# This allows RLS enforcement on app_role while still permitting DDL migrations
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/propdex
MIGRATION_DATABASE_URL=

# ========================================
# JWT Configuration
# ========================================
# Environment label used in health output and deploy defaults
ENVIRONMENT=development

# Secret key for signing JWT tokens — MUST be strong and unique in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# JWT algorithm (HS256 recommended for symmetric signing)
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# OAuth Configuration
# ========================================
# Google OAuth credentials (get from https://console.cloud.google.com)
# Leave empty to disable Google authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================================
# Email Configuration
# ========================================
# SMTP credentials for sending verification and reset emails
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@propdex.nl
MAIL_SERVER=localhost
MAIL_PORT=587

# ========================================
# Frontend Configuration
# ========================================
# Frontend URL for CORS and email verification/reset links
FRONTEND_URL=http://localhost:9300

# Allowed CORS origins (comma-separated for multiple origins)
# Example for multiple: http://localhost:9300,https://app.propdex.nl
CORS_ORIGINS=http://localhost:9300

# Refresh-cookie settings
# Leave COOKIE_SECURE unset to auto-detect based on FRONTEND_URL scheme
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/auth

# ========================================
# Freshness Configuration
# ========================================
# Minimum freshness threshold in hours (prevents excessive external API calls)
# Organizations can configure higher thresholds, but never lower than this
# Default: 1 hour (prevents abuse while allowing reasonable refresh frequency)
MIN_FRESHNESS_THRESHOLD_HOURS=1

# ========================================
# Government API Configuration
# ========================================
# BAG (Basisregistraties Adressen en Gebouwen) API key
# Register at: https://lvbag.github.io/BAG-API/Apis/bag-api-individuele-bevragingen
BAG_API_KEY=

# DSO (Digitaal Stelsel Omgevingswet) Ruimtelijke Plannen API key
# Register at: https://developer.omgevingswet.overheid.nl
DSO_API_KEY=

# ========================================
# AI Configuration
# ========================================
# Anthropic API key for Claude AI parsing of bestemmingsplannen
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Redis URL for ARQ task queue (async background job processing)
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0
