# Propdex legacy root env example
# Backend runtime now loads backend/.env explicitly. Keep project-specific
# backend settings in backend/.env to avoid mixing old root-level configs.

# ========================================
# Database Configuration
# ========================================
# PostgreSQL connection URL for async SQLAlchemy
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/propdex

# ========================================
# JWT Configuration
# ========================================
# Environment label used in health output and deploy defaults
ENVIRONMENT=development

# Secret key for signing JWT tokens — MUST be strong and unique in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# JWT algorithm (HS256 recommended for symmetric signing)
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# OAuth Configuration
# ========================================
# Google OAuth credentials (get from https://console.cloud.google.com)
# Leave empty to disable Google authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================================
# Email Configuration
# ========================================
# SMTP credentials for sending verification and reset emails
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@propdex.nl
MAIL_SERVER=localhost
MAIL_PORT=587

# ========================================
# Frontend Configuration
# ========================================
# Frontend URL for CORS and email verification/reset links
FRONTEND_URL=http://localhost:9300

# Allowed CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:9300

# Refresh-cookie settings
# Leave COOKIE_SECURE unset to auto-detect based on FRONTEND_URL scheme
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/auth
